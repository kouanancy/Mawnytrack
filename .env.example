# Fournie par l'intégration Neon de Vercel
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Connexion directe (sans pooler), utilisée en priorité par les migrations si présente
# DATABASE_URL_UNPOOLED=postgres://user:password@host/db?sslmode=require
# Secret Better Auth (déjà défini sur Vercel)
BETTER_AUTH_SECRET=
# Optionnel : URL publique (déduite automatiquement sur Vercel)
# BETTER_AUTH_URL=https://mawnytrack.vercel.app
# Optionnel : fuseau horaire des bornes de mois et de journée (défaut : Africa/Abidjan)
# APP_TIMEZONE=Africa/Abidjan
